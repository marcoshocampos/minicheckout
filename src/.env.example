# ---------------------------------------------------------------------------
# .env DO LARAVEL — só configuração de aplicação.
#
# Topologia (DB_HOST, REDIS_HOST, QUEUE_CONNECTION, CACHE_STORE, LOG_CHANNEL,
# GATEWAY_URL) é injetada pelo docker-compose como variável de ambiente, e o
# Dotenv do Laravel não sobrescreve variável que já existe no ambiente.
# Ou seja: dentro do Docker, o compose ganha destes valores. Eles ficam aqui
# para o caso de rodar fora do Docker e como documentação.
# ---------------------------------------------------------------------------

APP_NAME="Mini Checkout"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# stderr: o log sai no `docker compose logs`, não num arquivo esquecido dentro
# do container. A Fase 1 trocou o formatter deste canal para JSON, pela env
# LOG_STDERR_FORMATTER abaixo.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# FASE 1, passo 1 — o log em JSON é uma env, não código: uma linha JSON por
# evento, com message, level, channel, datetime, context e extra.
#
# NÃO deixe esta variável VAZIA. `LOG_STDERR_FORMATTER=` faz o env() devolver
# string vazia, o canal stderr não se constrói e o Laravel cai calado no
# emergency logger, que escreve em storage/logs/laravel.log DENTRO do
# container — ou seja, log nenhum no `docker compose logs`. Para voltar ao
# formato de texto, COMENTE a linha (config/logging.php trata ausência e vazio
# igual, de propósito).
#
# Depois de mudar: `docker compose restart app worker` (o canal é construído
# na inicialização do framework).
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

# Quem escreveu a linha de log. `app` e `worker` rodam a MESMA imagem, então o
# papel do processo vem de quem o subiu: o docker-compose define isto por
# container. Aqui fica só o default, para quem roda artisan fora do Docker.
LOG_SOURCE=app

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=minicheckout
DB_USERNAME=minicheckout
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="checkout@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# Gateway de pagamento fake (serviço `gateway` do compose).
GATEWAY_URL=http://gateway:8080

# ---------------------------------------------------------------------------
# FASE 4 — tracing. Vai entrar algo assim:
#   OTEL_PHP_AUTOLOAD_ENABLED=true
#   OTEL_SERVICE_NAME=minicheckout-app
#   OTEL_TRACES_EXPORTER=otlp
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318
#   OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
#   OTEL_PROPAGATORS=tracecontext,baggage
# ---------------------------------------------------------------------------
