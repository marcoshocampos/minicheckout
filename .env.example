# ---------------------------------------------------------------------------
# .env DO DOCKER COMPOSE (não é o .env do Laravel, que fica em src/.env)
#
# Regra do projeto: TOPOLOGIA (host, porta, senha, url de serviço) vem daqui,
# via compose. CONFIGURAÇÃO DE APLICAÇÃO vem de src/.env.
# O Dotenv do Laravel não sobrescreve variável que já existe no ambiente,
# então o que o compose injeta sempre ganha de src/.env.
# ---------------------------------------------------------------------------

# Portas publicadas no host. 8000 e 3000 estão ocupadas por outro projeto.
APP_PORT=8010
GATEWAY_PORT=8011
SWAGGER_PORT=8012
GRAFANA_PORT=3010
DB_PORT_HOST=55432
REDIS_PORT_HOST=56379
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# Postgres
DB_DATABASE=minicheckout
DB_USERNAME=minicheckout
DB_PASSWORD=secret

# ---------------------------------------------------------------------------
# Caos do gateway fake. Taxas são de 0 a 1 (0.3 = 30% das chamadas).
# Mexeu aqui? `docker compose up -d gateway` para recarregar.
# Para um teste pontual sem restart, use os headers X-Chaos-* (veja README).
# ---------------------------------------------------------------------------
GATEWAY_LATENCY_MS=0          # latência fixa em toda chamada
GATEWAY_FAIL_RATE=0           # 500: erro INESPERADO -> reportar e retentar
GATEWAY_DECLINE_RATE=0        # 402: erro ESPERADO   -> responder, não retentar
GATEWAY_TIMEOUT_RATE=0        # dorme mais que o timeout do cliente
GATEWAY_TIMEOUT_SLEEP_MS=30000
GATEWAY_DUPLICATE_WEBHOOK=0   # nº de webhooks EXTRA (mesmo event_id)
GATEWAY_WEBHOOK_DELAY_MS=400  # atraso do webhook; aumente para ele chegar fora de ordem
GATEWAY_WEBHOOK_URL=http://nginx/webhooks/payments
