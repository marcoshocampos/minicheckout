# LF em tudo. Script shell com CRLF quebra o entrypoint do container com um
# erro que parece outra coisa ("no such file or directory" no shebang).
* text=auto eol=lf

*.sh      text eol=lf
*.php     text eol=lf
*.yml     text eol=lf
*.conf    text eol=lf
Dockerfile text eol=lf

*.png binary
*.ico binary
